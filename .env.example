# =============================================================================
# VisionRAG-X Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# LLM Configuration
# ---------------------------------------------------------------------------
# Provider: openai | gemini | local
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-pro

# Local LLM via Ollama (or any OpenAI-compatible endpoint)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.1:8b

# ---------------------------------------------------------------------------
# Embedding
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# Device: cpu | cuda | mps
EMBEDDING_DEVICE=cpu

# ---------------------------------------------------------------------------
# Qdrant Vector Database
# ---------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=visionrag_x

# ---------------------------------------------------------------------------
# PostgreSQL (metadata & document store)
# ---------------------------------------------------------------------------
POSTGRES_URL=postgresql+asyncpg://visionrag:visionrag@localhost:5432/visionrag_x
POSTGRES_SYNC_URL=postgresql://visionrag:visionrag@localhost:5432/visionrag_x

# ---------------------------------------------------------------------------
# Storage Paths
# ---------------------------------------------------------------------------
UPLOAD_DIR=./data/uploads
FRAMES_DIR=./data/frames
TRANSCRIPTS_DIR=./data/transcripts
PROCESSED_DIR=./data/processed

# ---------------------------------------------------------------------------
# Video / Audio Processing
# ---------------------------------------------------------------------------
# Frame extraction interval in seconds
FRAME_INTERVAL=2
# Whisper model size: tiny | base | small | medium | large-v3
WHISPER_MODEL=base
# Device for Whisper: cpu | cuda
WHISPER_DEVICE=cpu
# Quantization: int8 | float16 | float32
WHISPER_COMPUTE_TYPE=int8

# ---------------------------------------------------------------------------
# OCR
# ---------------------------------------------------------------------------
# Comma-separated language codes (e.g., en,fr,de)
OCR_LANGUAGE=en

# ---------------------------------------------------------------------------
# Vision Model (for frame captioning / VQA)
# Leave blank to use the primary LLM_PROVIDER's vision capability
# ---------------------------------------------------------------------------
VISION_MODEL=

# ---------------------------------------------------------------------------
# Hybrid Retrieval Weights  (must sum to 1.0)
# ALPHA = semantic (dense) weight
# BETA  = lexical (BM25/sparse) weight
# GAMMA = visual similarity weight
# ---------------------------------------------------------------------------
RETRIEVAL_ALPHA=0.6
RETRIEVAL_BETA=0.3
RETRIEVAL_GAMMA=0.1

# ---------------------------------------------------------------------------
# Conflict Detection
# ---------------------------------------------------------------------------
CONFLICT_DETECTION_ENABLED=true
# Severity threshold [0.0, 1.0] — conflicts above this are surfaced to the user
CONFLICT_SEVERITY_THRESHOLD=0.5

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
# Set to true only in development
DEBUG=false
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Strong random string — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key

# ---------------------------------------------------------------------------
# Celery / Redis (reserved for future async task queue)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
